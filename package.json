{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx tests/ledgerEngine.test.ts && tsx tests/reports.test.ts && tsx tests/sync.test.ts && tsx tests/hrAdvances.test.ts && tsx tests/payroll.test.ts && tsx tests/zcrypto.test.ts && tsx tests/api.test.ts && tsx tests/supermarket.test.ts",
    "cf:dev": "vite build && wrangler dev",
    "cf:deploy": "vite build && wrangler deploy",
    "fb:build": "vite build && esbuild firebase/functions/src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=firebase/functions/lib/index.js --external:firebase-admin --external:firebase-functions --external:megajs --external:undici",
    "fb:deploy": "npm run fb:build && cd firebase/functions && npm install --omit=dev && cd ../.. && npx -y firebase-tools@15.0.0 deploy",
    "test:api": "tsx tests/apiE2E.ts"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "html2pdf.js": "^0.14.0",
    "html5-qrcode": "^2.3.8",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.546.0",
    "megajs": "^1.3.9",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "undici": "^6.21.3",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250924.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.27.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "wrangler": "4.40.0"
  }
}